{
  "name": "@coldsurfers/screens",
  "version": "0.0.0",
  "description": "React Native screen shell — safe-area · tab bar offsets · suspense boundary, built on @coldsurfers/design-system.",
  "keywords": [
    "react-native",
    "screen",
    "safe-area",
    "design-system",
    "coldsurfers"
  ],
  "license": "MIT",
  "author": "yungblud <killi8n@gmail.com>",
  "type": "module",
  "homepage": "https://github.com/coldsurfers/public/tree/main/packages/screens",
  "bugs": "https://github.com/coldsurfers/public/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldsurfers/public.git",
    "directory": "packages/screens"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./AppScreen": {
      "types": "./dist/AppScreen.d.ts",
      "default": "./dist/AppScreen.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "check:type": "tsc --noEmit",
    "check:exports": "attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "@coldsurfers/design-system": ">=0.20.0",
    "@emotion/native": "^11",
    "@emotion/react": "^11",
    "react": "^19",
    "react-native": ">=0.81",
    "react-native-safe-area-context": ">=5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@coldsurfers/design-system": "workspace:*",
    "@emotion/native": "11.11.0",
    "@emotion/react": "11.10.6",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-native": "0.87.0",
    "react-native-safe-area-context": "5.9.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-dts": "^4.5.4"
  }
}
