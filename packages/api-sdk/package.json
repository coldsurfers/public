{
  "name": "@coldsurfers/api-sdk",
  "version": "4.1.0",
  "description": "Type-safe API SDK for COLDSURF (billets) services.",
  "keywords": [
    "api-sdk",
    "openapi",
    "react-query",
    "coldsurf"
  ],
  "license": "MIT",
  "author": "yungblud <killi8n@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/coldsurfers/public/tree/main/packages/api-sdk",
  "bugs": "https://github.com/coldsurfers/public/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldsurfers/public.git",
    "directory": "packages/api-sdk"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./queries": {
      "types": "./dist/queries.d.ts",
      "default": "./dist/queries.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "swagger": "tsx ./scripts/codegen.ts",
    "check:type": "tsc --noEmit",
    "check:exports": "attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.59.16",
    "openapi-fetch": ">=0.14.0",
    "react": ">=19.1.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@tanstack/react-query": "5.59.16",
    "@types/react": "catalog:",
    "openapi-fetch": "0.14.0",
    "openapi-typescript": "^7.9.1",
    "react": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.59.16",
    "openapi-typescript-helpers": "^0.0.15"
  }
}
