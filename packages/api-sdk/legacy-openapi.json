{
  "openapi": "3.0.3",
  "info": {
    "title": "billets-server (legacy · Fastify on Lambda)",
    "description": "Hono 이관이 안 끝난 잔여 계약. 소비처가 옮겨가면 이 파일은 줄다가 사라진다.",
    "version": "1.0.0"
  },
  "paths": {
    "/v2/auth/email/verification-codes": {
      "post": {
        "tags": ["v2", "auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendAuthCodeResponseDTOSchema"
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTOSchema"
                }
              }
            }
          },
          "500": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTOSchema"
                }
              }
            }
          }
        }
      }
    },
    "/v2/auth/email/verification-codes/verify": {
      "post": {
        "tags": ["v2", "auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "authCode": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 6
                  }
                },
                "required": ["email", "authCode"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmAuthCodeResponseDTOSchema"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTOSchema"
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTOSchema"
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTOSchema"
                }
              }
            }
          },
          "500": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTOSchema"
                }
              }
            }
          }
        }
      }
    },
    "/v2/auth/users": {
      "post": {
        "tags": ["v2", "auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": ["google"]
                      },
                      {
                        "type": "string",
                        "enum": ["apple"]
                      },
                      {
                        "type": "string",
                        "enum": ["email"]
                      }
                    ]
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "token": {
                    "type": "string"
                  },
                  "platform": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": ["android"]
                      },
                      {
                        "type": "string",
                        "enum": ["ios"]
                      },
                      {
                        "type": "string",
                        "enum": ["web"]
                      }
                    ]
                  },
                  "termsVersionIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "marketingConsent": {
                    "type": "boolean"
                  },
                  "nightMarketingConsent": {
                    "type": "boolean"
                  }
                },
                "required": ["provider", "email"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserWithAuthTokenDTOSchema"
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTOSchema"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTOSchema"
                }
              }
            }
          },
          "500": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTOSchema"
                }
              }
            }
          }
        }
      }
    },
