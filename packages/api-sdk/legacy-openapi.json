      "PresignPostBodyDTOSchema": {
        "type": "object",
        "properties": {
          "concertId": {
            "type": "string"
          },
          "resolution": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "type": {
            "type": "string",
            "enum": ["poster", "detail-image"]
          }
        },
        "required": ["concertId", "resolution", "type"],
        "additionalProperties": false
      },
      "PresignPostBodyDTOSchemaInput": {
        "type": "object",
        "properties": {
          "concertId": {
            "type": "string"
          },
          "resolution": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "type": {
            "type": "string",
            "enum": ["poster", "detail-image"]
          }
        },
        "required": ["concertId", "resolution", "type"]
      },
      "PresignedPostDTOSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": ["url", "fields"],
        "additionalProperties": false
      },
      "ReissueTokenBodyDTOSchemaInput": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": ["refreshToken"]
      },
      "SendAuthCodeResponseDTOSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": ["email"],
        "additionalProperties": false
      },
      "UserDTOSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "handle": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserHandleDTOSchema"
              },
              {
                "type": "null"
              }
            ]
          },
          "deactivatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta": {
            "type": "object",
            "properties": {
              "consentRequired": {
                "type": "boolean"
              }
            },
            "required": ["consentRequired"],
            "additionalProperties": false
          }
        },
        "required": ["id", "email", "provider", "handle", "deactivatedAt"],
        "additionalProperties": false
      },
      "UserHandleDTOSchema": {
        "type": "string",
        "pattern": "^@[a-zA-Z0-9._-]{3,30}$"
      },
      "UserWithAuthTokenDTOSchema": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDTOSchema"
          },
          "authToken": {
            "type": "object",
            "properties": {
              "accessToken": {
                "type": "string"
              },
              "refreshToken": {
                "type": "string"
              }
            },
            "required": ["accessToken", "refreshToken"],
            "additionalProperties": false
          }
        },
        "required": ["user", "authToken"],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "AccessTokenAuth": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
