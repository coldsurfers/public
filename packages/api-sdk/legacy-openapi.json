              },
              {
                "type": "string",
                "const": "USER_DEACTIVATED"
              },
              {
                "type": "string",
                "const": "USER_ALREADY_EXISTING"
              },
              {
                "type": "string",
                "const": "EMAIL_AUTH_REQUEST_NOT_FOUND"
              },
              {
                "type": "string",
                "const": "INVALID_EMAIL_AUTH_REQUEST"
              },
              {
                "type": "string",
                "const": "EMAIL_AUTH_REQUEST_ALREADY_AUTHENTICATED"
              },
              {
                "type": "string",
                "const": "EMAIL_AUTH_REQUEST_TIMEOUT"
              },
              {
                "type": "string",
                "const": "UNKNOWN"
              },
              {
                "type": "string",
                "const": "EVENT_NOT_FOUND"
              },
