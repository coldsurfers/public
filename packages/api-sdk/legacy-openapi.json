              {
                "type": "string",
                "const": "ENTRY_TICKETS_ALREADY_ISSUED"
              },
              {
                "type": "string",
                "const": "ENTRY_TICKET_NOT_FOUND"
              },
              {
                "type": "string",
                "const": "ENTRY_TICKET_ALREADY_USED"
              },
              {
                "type": "string",
