              {
                "type": "string",
                "const": "INVALID_PASSWORD"
              },
              {
                "type": "string",
                "const": "INVALID_ACCESS_TOKEN"
              },
              {
                "type": "string",
                "const": "INVALID_QUERY_STRING"
              },
              {
                "type": "string",
                "const": "USER_NOT_FOUND"
              },
              {
                "type": "string",
                "const": "CONCERT_NOT_FOUND"
              },
              {
                "type": "string",
                "const": "SUBSCRIBED_CONCERT_NOT_FOUND"
              },
              {
                "type": "string",
                "const": "ARTIST_NOT_FOUND"
              },
              {
                "type": "string",
                "const": "VENUE_NOT_FOUND"
              },
              {
                "type": "string",
                "const": "SUBSCRIBED_ARTIST_NOT_FOUND"
              },
              {
                "type": "string",
