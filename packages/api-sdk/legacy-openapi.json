              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTOSchema"
                }
              }
            }
          }
        }
      }
    },
    "/v2/auth/check": {
      "post": {
        "tags": ["v2", "auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": ["google"]
                      },
                      {
                        "type": "string",
                        "enum": ["apple"]
                      }
                    ]
                  },
                  "token": {
                    "type": "string"
                  },
                  "platform": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": ["ios"]
                      },
                      {
                        "type": "string",
                        "enum": ["android"]
                      },
                      {
                        "type": "string",
                        "enum": ["web"]
                      }
                    ]
                  }
                },
                "required": ["provider", "token"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "exists": {
                      "type": "boolean"
                    }
                  },
                  "required": ["exists"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTOSchema"
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTOSchema"
                }
              }
            }
          },
          "500": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTOSchema"
                }
              }
            }
          }
        }
      }
    },
    "/v2/events/upload-tokens": {
      "post": {
        "tags": ["v2", "events"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresignPostBodyDTOSchemaInput"
              }
            }
          }
        },
        "security": [
          {
            "AccessTokenAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresignedPostDTOSchema"
                }
              }
            }
          },
          "500": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDTOSchema"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmAuthCodeResponseDTOSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": ["email"],
        "additionalProperties": false
      },
      "ErrorResponseDTOSchema": {
        "type": "object",
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string",
                "const": "INVALID_ANONYMOUS_USER"
