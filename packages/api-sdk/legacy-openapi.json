                "type": "string",
                "const": "IMAGE_KEY_NOT_FOUND"
              },
              {
                "type": "string",
                "const": "IMAGE_NOT_FOUND"
              },
              {
                "type": "string",
                "const": "REFRESH_TOKEN_NOT_FOUND"
              },
              {
                "type": "string",
                "const": "TICKET_NOT_FOUND"
              },
              {
                "type": "string",
                "const": "INVALID_ACTION_TOKEN"
              },
              {
                "type": "string",
                "const": "INVALID_GEO_DATA"
              },
              {
                "type": "string",
                "const": "INVALID_FEED_ENTITY_TYPE"
              },
              {
                "type": "string",
                "const": "INVALID_FEED"
              },
              {
                "type": "string",
