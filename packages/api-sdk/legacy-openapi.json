    "/v2/auth/tokens/refresh": {
      "post": {
        "tags": ["v2", "auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReissueTokenBodyDTOSchemaInput"
