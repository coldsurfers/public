{
  "name": "@coldsurfers/shared-utils",
  "version": "0.1.0",
  "description": "COLDSURF shared utilities — framework-agnostic helpers shared across web, server, and native surfaces.",
  "keywords": [
    "utils",
    "date",
    "kst",
    "coldsurf"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/coldsurfers/public/tree/main/packages/shared-utils",
  "bugs": "https://github.com/coldsurfers/public/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldsurfers/public.git",
    "directory": "packages/shared-utils"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./date": {
      "types": "./dist/date.d.ts",
      "default": "./dist/date.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "check:type": "tsc --noEmit",
    "check:exports": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "date-fns": "4.1.0",
    "date-fns-tz": "^3.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  }
}
