{
  "name": "@coldsurfers/shared-utils",
  "version": "0.2.0",
  "description": "COLDSURF shared utilities — framework-agnostic helpers shared across web, server, and native surfaces.",
  "keywords": [
    "utils",
    "date",
    "kst",
    "coldsurf"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/coldsurfers/public/tree/main/packages/shared-utils",
  "bugs": "https://github.com/coldsurfers/public/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldsurfers/public.git",
    "directory": "packages/shared-utils"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./date": {
      "types": "./dist/date.d.ts",
      "default": "./dist/date.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "default": "./dist/email.js"
    },
    "./event-category": {
      "types": "./dist/event-category.d.ts",
      "default": "./dist/event-category.js"
    },
    "./jwt": {
      "types": "./dist/jwt.d.ts",
      "default": "./dist/jwt.js"
    },
    "./kopis-price": {
      "types": "./dist/kopis-price.d.ts",
      "default": "./dist/kopis-price.js"
    },
    "./location-city": {
      "types": "./dist/location-city.d.ts",
      "default": "./dist/location-city.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./number": {
      "types": "./dist/number.d.ts",
      "default": "./dist/number.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "default": "./dist/parser.js"
    },
    "./seo-head": {
      "types": "./dist/seo-head.d.ts",
      "default": "./dist/seo-head.js"
    },
    "./slug": {
      "types": "./dist/slug.d.ts",
      "default": "./dist/slug.js"
    },
    "./uri": {
      "types": "./dist/uri.d.ts",
      "default": "./dist/uri.js"
    },
    "./uuid": {
      "types": "./dist/uuid.d.ts",
      "default": "./dist/uuid.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "check:type": "tsc --noEmit",
    "check:exports": "node scripts/check-entries.mjs && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "slugify": "1.6.6"
  },
  "peerDependencies": {
    "date-fns": "^4",
    "date-fns-tz": "^3",
    "jwt-decode": "^4",
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "date-fns": {
      "optional": true
    },
    "date-fns-tz": {
      "optional": true
    },
    "jwt-decode": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "date-fns": "4.1.0",
    "date-fns-tz": "^3.2.0",
    "jwt-decode": "^4.0.0",
    "next": "^15.5.0",
    "schema-dts": "^1.1.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  }
}
