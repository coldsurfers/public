{
  "name": "@coldsurfers/wbe-theme",
  "version": "0.0.0",
  "description": "WHITE BLIND EYE theme layer — CSS variables, self-hosted fonts, and vanilla-extract recipes.",
  "keywords": [
    "vanilla-extract",
    "design-tokens",
    "white-blind-eye",
    "coldsurf"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.css.ts"
  ],
  "homepage": "https://github.com/coldsurfers/public/tree/main/packages/wbe-theme",
  "bugs": "https://github.com/coldsurfers/public/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldsurfers/public.git",
    "directory": "packages/wbe-theme"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sprinkles": {
      "types": "./dist/sprinkles.d.ts",
      "default": "./dist/sprinkles.js"
    },
    "./fonts": "./dist/fonts.js",
    "./layers": {
      "types": "./dist/layers.d.ts",
      "default": "./dist/layers.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "check:type": "tsc --noEmit",
    "check:exports": "attw --pack . --profile esm-only --exclude-entrypoints ./styles.css"
  },
  "dependencies": {
    "@coldsurfers/wbe-tokens": "workspace:^",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.7.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@vanilla-extract/vite-plugin": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-dts": "^4.5.4"
  }
}
