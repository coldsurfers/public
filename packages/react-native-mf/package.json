{
  "name": "@coldsurfers/react-native-mf",
  "version": "0.0.0",
  "description": "React Native microfrontend layer — load remote bundles into the host JS runtime with a shared dependency scope.",
  "keywords": [
    "react-native",
    "microfrontend",
    "module-federation",
    "esbuild",
    "coldsurfers"
  ],
  "license": "MIT",
  "author": "yungblud <killi8n@gmail.com>",
  "type": "module",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "homepage": "https://github.com/coldsurfers/public/tree/main/packages/react-native-mf",
  "bugs": "https://github.com/coldsurfers/public/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldsurfers/public.git",
    "directory": "packages/react-native-mf"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "react-native-mf": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "check:type": "tsc --noEmit",
    "check:exports": "attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "esbuild": ">=0.21.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-dts": "^4.5.4"
  }
}
