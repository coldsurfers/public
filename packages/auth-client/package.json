{
  "name": "@coldsurfers/auth-client",
  "version": "0.3.0",
  "description": "Cross-environment TypeScript SDK for coldsurf-auth-server. Mirrors the v1/v2/user-identity surface and pluggable token storage (cookie · localStorage · expo-secure-store · memory).",
  "keywords": [
    "auth",
    "coldsurfers",
    "sdk"
  ],
  "license": "MIT",
  "author": "yungblud <killi8n@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/coldsurfers/public/tree/main/packages/auth-client",
  "bugs": "https://github.com/coldsurfers/public/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldsurfers/public.git",
    "directory": "packages/auth-client"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "check:type": "tsc --noEmit",
    "check:exports": "attw --pack . --profile esm-only",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-dts": "^4.5.4"
  }
}
