{
  "name": "@coldsurfers/data-models",
  "version": "0.12.0",
  "description": "COLDSURF shared zod schemas and DTOs — the wire contract between servers, web surfaces, and native apps.",
  "keywords": [
    "dto",
    "zod",
    "schema",
    "coldsurf"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/coldsurfers/public/tree/main/packages/data-models",
  "bugs": "https://github.com/coldsurfers/public/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldsurfers/public.git",
    "directory": "packages/data-models"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "check:type": "tsc --noEmit",
    "check:exports": "attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "zod": ">=3.23.8"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-dts": "^4.5.4",
    "zod": "^4.4.3"
  }
}
