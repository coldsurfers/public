# @coldsurfers 스코프는 GitHub Packages 에서 받고 거기로 발행한다.
# 토큰은 체크인하지 않는다 — CI 는 setup-node 가, 로컬은 ~/.npmrc 가 쥔다.
@coldsurfers:registry=https://npm.pkg.github.com

# node 22 미만을 설치 단계에서 거절한다(root engines: ">=22").
# 없으면 node 20 에서 install 이 통과하고, 대신 `next build` 가
# `require() of ES Module ...fumadocs-mdx/dist/webpack/macro.js` 로 깨진다 —
# 원인과 무관해 보이는 에러다. require(ESM) 이 node 22.12+/20.19+ 에서만 되기 때문.
# 게다가 turbopack 이 그 실패를 `.next` 에 캐싱해서, node 를 올려도 캐시를 지우기 전엔 계속 깨진다.
engine-strict=true
